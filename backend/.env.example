PORT=8787
FRONTEND_URL=http://localhost:5173

# Proxy hops Express may trust when resolving the client IP for anonymous rate limiting.
# Leave unset: single hop on Cloud Run/Functions, loopback-only in local development.
TRUST_PROXY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary signed uploads (server-only). Rotate the API secret if it was ever exposed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_PACKAGE_LENGTH=
SHIPROCKET_PACKAGE_BREADTH=
SHIPROCKET_PACKAGE_HEIGHT=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_WEBHOOK_SECRET=
PHONEPE_REFUND_ENDPOINT=
PHONEPE_REFUND_AUTH_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
