{
  "name": "partswala-ind-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --project demo-partswala-vendor-import --only auth,firestore \"node --test vendorBulkImport.emulator.test.js\"",
