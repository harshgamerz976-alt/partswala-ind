{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "site": "partswalaflutter",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
            { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https:; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.google.com https://www.gstatic.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com https://www.google.com https://recaptcha.google.com https://checkout.razorpay.com"
            }
          ]
        },
        {
          "source": "/assets/**/*-????????*.*",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        }
      ],
      "rewrites": [
        { "regex": "^[/\\\\]$", "destination": "/index.html" },
        { "source": "/products", "destination": "/index.html" },
        { "source": "/products/**", "destination": "/index.html" },
        { "source": "/product", "destination": "/index.html" },
        { "source": "/product/**", "destination": "/index.html" },
        { "source": "/legal", "destination": "/index.html" },
        { "source": "/legal/**", "destination": "/index.html" },
        { "source": "/profile", "destination": "/index.html" },
        { "source": "/my-enquiries", "destination": "/index.html" },
        { "source": "/cart", "destination": "/index.html" },
        { "source": "/checkout", "destination": "/index.html" },
        { "source": "/login", "destination": "/index.html" },
        { "source": "/forgot-password", "destination": "/index.html" },
        { "source": "/register", "destination": "/index.html" },
        { "source": "/signup", "destination": "/index.html" },
        { "source": "/orders", "destination": "/index.html" },
        { "source": "/orders/**", "destination": "/index.html" },
        { "source": "/dashboard", "destination": "/index.html" },
        { "source": "/sell", "destination": "/index.html" },
        { "source": "/vendor", "destination": "/index.html" },
        { "source": "/vendor/**", "destination": "/index.html" },
        { "source": "/admin", "destination": "/index.html" },
        { "source": "/admin/**", "destination": "/index.html" }
      ]
    },
    {
      "site": "partswalaind",
