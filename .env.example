VITE_API_URL=http://localhost:8787
VITE_AI_API_URL=http://localhost:8787

# Razorpay Key ID is a public identifier (never a secret). The Key Secret stays in backend/.env.
VITE_RAZORPAY_KEY_ID=

# Cloudinary is signed by the backend: put CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and
# CLOUDINARY_API_SECRET in backend/.env. Never expose a Cloudinary API secret through VITE_*.
